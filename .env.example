# GLM 为主模型；GLM 请求失败时自动回退到 DeepSeek
LLM_PROVIDER=glm
GLM_API_KEY=你的智谱API_Key
DEEPSEEK_API_KEY=你的DeepSeek_API_Key

# 也支持 ZAI_API_KEY 作为 GLM Key；以下覆盖项可选
# GLM_MODEL=glm-5.3
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 如需仅使用 DeepSeek 或其他 OpenAI 兼容服务，可改为 LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# OPENAI_API_KEY=your-compatible-api-key

# ===== Agent 配置 =====
LLM_TEMPERATURE=0
# 可选：Answer Accuracy 使用独立评测模型
# EVAL_JUDGE_MODEL=gpt-4o
MAX_RETRIES=3
# 单次查询最多允许返回的行数（超限会回溯 SQL）
RESULT_MAX_ROWS=10000
# 核心查询后最多自动深挖几轮：默认 3，可配置 0～5
MAX_ANALYSIS_DEPTH=3

# ===== 代理（可选）=====
# 默认留空 = 忽略环境里的 socks 代理（DeepSeek 国内直连）。
# 如需走代理（例如访问 OpenAI），填 http 代理地址：
# LLM_PROXY=http://127.0.0.1:7890

# ===== 数据库 =====
DB_PATH=data/ecommerce.db

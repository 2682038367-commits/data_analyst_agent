# ===== DeepSeek（默认，OpenAI 兼容接口）=====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 或者直接用 OpenAI =====
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ===== Agent 配置 =====
LLM_TEMPERATURE=0
# 可选：Answer Accuracy 使用独立评测模型
# EVAL_JUDGE_MODEL=gpt-4o
MAX_RETRIES=3
# 单次查询最多允许返回的行数（超限会回溯 SQL）
RESULT_MAX_ROWS=10000
# 核心查询后最多自动深挖几轮
MAX_ANALYSIS_DEPTH=3

# ===== 代理（可选）=====
# 默认留空 = 忽略环境里的 socks 代理（DeepSeek 国内直连）。
# 如需走代理（例如访问 OpenAI），填 http 代理地址：
# LLM_PROXY=http://127.0.0.1:7890

# ===== 数据库 =====
DB_PATH=data/ecommerce.db
